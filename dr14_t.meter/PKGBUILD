# Maintainer: robot <cultofrobots [at] protonmail [dot] com>
# Website: https://github.com/CultofRobots/
pkgname=dr14_t.meter
pkgver=2.2.0
pkgrel=1
pkgdesc="Compute the DR14 of a given audio file according to the procedure described by the Pleasurize Music Foundation"
arch=(x86_64 armv7h aarch64)
url="https://github.com/simon-r/dr14_t.meter"
license=('GPL-3.0-only')
depends=(
  'python' 
  'flac' 
  'lame' 
  'faad2' 
  'ffmpeg' 
  'python-numpy'
  'python-mutagen'
  'vorbis-tools' 
)
optdepends=(
  'python-matplotlib: plot support for python' 
  'python-scipy: dyn compression'
)
makedepends=(
  'python-setuptools' 
  'python-build' 
  'python-installer' 
  'python-wheel'
)
provides=("${pkgname}")
conflicts=("${pkgname}-git")
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/simon-r/${pkgname}/archive/v${pkgver}.tar.gz")
sha256sums=('125733b8dc99ec48beaa57293efb23dd937a7bf8342be7cccbd61ca6f33ff56b')

build() {
	cd "$srcdir/${pkgname}-${pkgver}"
    python -m build --wheel --no-isolation
}

package() {
	cd "$srcdir/${pkgname}-${pkgver}"
    python -m installer --destdir="$pkgdir" dist/*.whl
}
